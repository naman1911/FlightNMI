# ---------------------------------------------------------------------------
# FlightNMI configuration. Copy this file to .env and fill in what you use.
# Anything left blank is simply switched off.
# ---------------------------------------------------------------------------

# Web page and admin login. ADMIN_TOKEN is the password for /admin.
# Use something long and random, e.g.  openssl rand -hex 24
PORT=8080
ADMIN_TOKEN=change-me-to-a-long-random-secret
# Public address of this service, used in the footer of messages (optional).
PUBLIC_URL=

# How often to ask the flight-data sources for positions (seconds, 10-60).
POLL_SECONDS=20
# Send the "approaching" alert when a flight is this many minutes out.
NOTICE_MINUTES=20
# Where recipients and the notification log are stored.
DATA_DIR=./data

# ----- Email (SMTP). Any mailbox works: Gmail app password, Zoho, SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FlightNMI <alerts@example.com>"

# ----- WhatsApp through Twilio (simplest to set up; sandbox works for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----- WhatsApp through Meta's official Cloud API (used only if Twilio is not set)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional approved template with one {{1}} body parameter. Without it, plain
# text is sent, which Meta only delivers inside a 24-hour customer window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ----- Optional: seed the three recipients on first start (JSON array).
# They can also be added or changed on the /admin page at any time.
# RECIPIENTS_JSON=[{"name":"Asha","email":"asha@example.com"},{"name":"Ravi","whatsapp":"+919876543210"}]
